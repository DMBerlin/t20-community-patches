<section class="tab t20cp-tab t20cp-rules {{tab.cssClass}}" data-group="main" data-tab="rules" id="t20cp-panel-rules" role="tabpanel" aria-labelledby="t20cp-tab-rules">
  <div class="t20cp-list">
    {{#each rules}}
    <div class="t20cp-row" data-id="{{id}}">
      <div class="t20cp-line">
        <span class="t20cp-name">{{label}}</span>
        {{#if single}}<span class="t20cp-control">{{{input}}}</span>{{/if}}
        <button type="button" class="t20cp-expand icon" data-action="expand" aria-expanded="false" aria-label="{{localize "T20CP.Manager.Expand"}}">
          <i class="fa-solid fa-chevron-down" inert></i>
        </button>
      </div>
      <div class="t20cp-detail" hidden>
        {{#if single}}
        <p>{{hint}}</p>
        {{else}}
        {{#each entries}}
        <div class="t20cp-subrule">
          <div class="t20cp-line">
            <span class="t20cp-name">{{label}}</span>
            <span class="t20cp-control">{{{input}}}</span>
          </div>
          <p class="hint">{{hint}}</p>
        </div>
        {{/each}}
        {{/if}}
      </div>
    </div>
    {{else}}
    <p class="hint">{{localize "T20CP.Manager.NoRules"}}</p>
    {{/each}}
  </div>
</section>
