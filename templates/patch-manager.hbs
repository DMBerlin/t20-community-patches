<div class="t20cp-manager scrollable">
  <p class="hint">{{localize "T20CP.Manager.Intro"}}</p>
  {{#if pendingReload}}
  <p class="notification warning t20cp-pending"><i class="fa-solid fa-rotate"></i> {{localize "T20CP.Manager.PendingReload"}}</p>
  {{/if}}
  {{#each groups}}
  <fieldset>
    <legend>{{label}}</legend>
    {{#each patches}}
    <div class="form-group t20cp-patch">
      <label for="t20cp-{{id}}">{{name}}</label>
      <div class="form-fields">
        <span class="t20cp-badge t20cp-badge--{{badge}}" data-tooltip="{{stateHint}}">{{stateLabel}}</span>
        {{#if issueUrl}}
        <a class="t20cp-issue" href="{{issueUrl}}" target="_blank" rel="noopener" data-tooltip="{{localize "T20CP.Manager.Issue"}}">#{{issue}}</a>
        {{/if}}
        <select id="t20cp-{{id}}" name="{{id}}" aria-label="{{localize "T20CP.Manager.Mode"}}">
          {{selectOptions modes selected=mode localize=true}}
        </select>
      </div>
      <p class="hint">{{hint}}</p>
    </div>
    {{/each}}
  </fieldset>
  {{/each}}
</div>
